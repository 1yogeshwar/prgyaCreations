# Existing server configuration
MONGO_URI=
CLIENT_URL=
ADMIN_URL=
JWT_SECRET=
JWT_EXPIRES_IN=
PORT=5000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ADMIN_EMAIL=
ADMIN_PASS=

# Required Shiprocket API configuration (server only; never expose to either React app)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Required: exact nickname and six-digit PIN for the registered Shiprocket pickup address
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=

# Required inbound webhook token. Configure this exact value as the Dashboard
# x-api-key token; it is distinct from Shiprocket API login credentials.
SHIPROCKET_WEBHOOK_TOKEN=

# Optional courier policy limits. Leave blank to select the best serviceable
# courier based on available rating first, then quoted shipping cost.
SHIPROCKET_COURIER_MAX_COST=
SHIPROCKET_COURIER_MIN_RATING=
